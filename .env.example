# --- Shared ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>
DEPLOYER_PRIVATE_KEY=0x...

# --- Contracts / deployment ---
ETHERSCAN_API_KEY=

# --- ENSv2 (Sepolia beta, ETHOnline hackathon deployment) ---
# Payment token accepted by the hackathon ETHRegistrar when registering the
# project's root .eth name. REQUIRED by `node integrations/ens/setup-agent-namespace.js`
# (it fails without it). It must be an ERC20 the registrar's rent oracle accepts,
# and the deployer must hold a balance + approve it. Swap addresses here if the
# hackathon's oracle lists a different token: check the deployment notes at
# https://docs.ens.domains/ensv2/overview (Deployments table) for the canonical list.
ENSV2_PAYMENT_TOKEN=0x<supported-ERC20>

# Project-owned ENSv2 namespace. Run ONE time, in this order:
#   node integrations/ens/setup-agent-namespace.js <rootLabel>   (e.g. agentcreditbureau)
# That registers <rootLabel>.eth, deploys your UserRegistry proxy via the Verifiable
# Factory, attaches it via setSubregistry, deploys the AgentSubnameRegistrar and grants
# it ROLE_REGISTRAR + ROLE_RENEW. It prints the two addresses below — save them.
ENS_AGENT_REGISTRY_ADDRESS=0x<deployed-project-user-registry (printed by setup)>
ENS_AGENT_REGISTRAR_ADDRESS=0x<deployed-agent-subname-registrar (printed by setup)>

# Official ENSv2 hackathon deployment addresses (Sepolia). The integration
# scripts already default to these; override only if ENS redeploys.
ENSV2_ETH_REGISTRAR=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENSV2_PARENT_REGISTRY=0x1d78834d97c1d7b1a38c1dedbd1a287cfed3971e
ENSV2_PUBLIC_RESOLVER=0xf9de4979ddb290baf5b760d0e788125017bc33f6
ENSV2_UNIVERSAL_RESOLVER=0xd26f2040d083af1cd2962ba303f4bea0c4faf142
ENSV2_USER_REGISTRY_IMPL=0x47b442d0cf617c41cabaff5f02f44dd1e5f72546
ENSV2_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENSV2_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780

# Per-agent identity script / simulator overrides (optional; scripts derive
# sensible defaults, including the root name agentcreditbureau.eth).
ENS_ROOT_NAME=agentcreditbureau.eth
ENS_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
# register-single-agent.js: authorizeTextRoles() must be sent by the agent's
# CONTROLLER wallet (it holds ALL_ROLES on the resolver). Set this key when the
# controller is not the deployer; otherwise the CLI warns and may be rejected.
CONTROLLER_PRIVATE_KEY=0x<optional-agent-controller-key>
# simulator/simulate-agent.js: the ADDRESS of the already-registered agent to
# prepend history to (e.g. the browser wallet that ran the frontend "Register
# identity" flow). Optional — falls back to the address derived from
# AGENT_PRIVATE_KEY below.
SIM_AGENT_CONTROLLER=0x...

# --- World AgentKit (SANDBOX ONLY — never production World ID) ---
# Credence runs on the World ID sandbox (WORLD_ID_ENVIRONMENT=staging). The
# AgentBook integration (register-first identity mint) uses the labeled
# sandbox AgentBook (backend/integrations/world/agentbook-sandbox.js) and the
# World Selfie Check uses the staging Developer Portal. Production World
# Chain AgentBook calls FAIL CLOSED unless WORLD_ALLOW_PRODUCTION=1 is set
# explicitly (never demo with it).
WORLD_APP_ID=app_...
WORLD_ID_ENVIRONMENT=staging
WORLD_ALLOW_PRODUCTION=0
# Optional override for the AgentBook CLI used by integrations/world/verify-agent.js
# (defaults to `npx @worldcoin/agentkit-cli`). Only relevant with the explicit
# production opt-in; sandbox mode never spawns the CLI.
AGENTKIT_CLI=

# --- World Selfie Check (prize track: medium-assurance liveness credential) ---
# From the Developer Portal (developer.world.org) after "Enable World ID 4.0":
# the RP signing key never leaves this file / the backend.
# Selfie Check (Beta) is access-gated — ask your World point of contact to
# enable the feature flag for this app before proofs will succeed.
# WORLD_ID_APP_ID falls back to WORLD_APP_ID above.
WORLD_RP_SIGNING_KEY=0x<64-hex-signing-key>
WORLD_ID_RP_ID=rp_...
# production | staging (staging = simulator + sandbox World ID app).
WORLD_ID_ENVIRONMENT=production
# Optional override of the Developer Portal verify endpoint base URL
# (defaults to https://developer.world.org/api/v4/verify/ for production and
# https://staging-developer.worldcoin.org/api/v4/verify/ otherwise).
# WORLD_ID_VERIFY_URL=https://developer.world.org/api/v4/verify/
# RP signature TTL in seconds (IDKit default 300).
# WORLD_SIGN_TTL_SECONDS=300
# Opt-in DEMO MODE: complete the full request->QR->verify loop with a clearly-
# labeled simulated credential (environment=demo-mock) until the Selfie Check
# feature flag is enabled for your app. Never leave on in production.
# WORLD_ID_MOCK=1

# --- CreditBureau deployment (fill after `npm run deploy:sepolia`) ---
CREDIT_BUREAU_ADDRESS=0x...

# --- Simulator (demo-agent controller; must already be registered with the
#     bureau via the frontend — this script only appends history) ---
AGENT_PRIVATE_KEY=0x...

# --- Hedera (testnet) ---
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=302e...
HEDERA_RPC_URL=https://testnet.hashio.io/api
ATS_FACTORY_ADDRESS=0x...
ATS_RESOLVER_ADDRESS=0x...

# --- Hedera x402 (ETHOnline track: AI & Agentic Payments on Hedera) ---
# The Credence x402 service pays out to the operator account.
# X402_PAY_TO defaults to HEDERA_OPERATOR_ID.
# X402_SERVER_URL=http://127.0.0.1:8787
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# X402_PRICE_REPORT_TINYBAR=100
# X402_PRICE_RATE_TINYBAR=50
# The CONSUMING agent wallet (payer) — a Hedera testnet 0.0.x account
# funded with a few testnet HBAR via https://portal.hedera.com
# X402_PAYER_ACCOUNT=0.0.xxxxx
# X402_PAYER_KEY=302e...

# --- Subgraph ---
# Overrides the startBlock written into contracts/deployments/<network>.json.
GRAPH_START_BLOCK=11675965

# --- The Graph composition (ETHOnline 2026 composable/standardized track) ---
# One free Gateway API key powers BOTH standardized-subgraph discovery AND
# The Graph's hosted Subgraph MCP. Create it at https://thegraph.com/studio/.
# Without it the composable legs degrade to "needs-key" in the UI/MCP tools.
GRAPH_API_KEY=<optional: graph studio / gateway api key>
# Hosted Subgraph MCP endpoint (overridable; official default below).
SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse
# Optional pin: JSON map of standardized provider slug -> GraphQL endpoint,
# e.g. {"curve-ethereum":"https://api.gateway.thegraph.com/api/<key>/subgraphs/id/<id>"}
# Pins beat MCP-based discovery; handy when the Network subgraph id is known.
# GRAPH_STANDARD_ENDPOINTS={}
GRAPH_ENDPOINT=https://api.studio.thegraph.com/query/<id>/agent-credit-bureau/version/latest

# --- AI credit analyst (optional narrative; the deterministic recommendation
#     works without any of these) ---
OPENAI_API_KEY=
AI_MODEL_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# --- Backend (server-owned keys; npm run backend) ---
# Optional overrides for backend/config.js (defaults: 127.0.0.1:8787,
# CORS origin http://localhost:3000).
# BACKEND_PORT=8787
# BACKEND_HOST=127.0.0.1
# BACKEND_ORIGIN=http://localhost:3000
# The standalone World bridge can also run on its own port:
# WORLD_VERIFY_PORT=8788
# WORLD_VERIFY_ORIGIN=http://localhost:5173

# --- World Selfie Check (medium-assurance liveness credential) ---
# Required by backend/integrations/world/selfie-check.js. WORLD_APP_ID above
# is used as a fallback for WORLD_ID_APP_ID. WORLD_ID_MOCK=1 runs the whole
# flow in labeled demo mode (no Developer Portal call) until the Selfie Check
# feature flag is enabled for your app.
#
# ⚠ THIS PROJECT RUNS ON THE WORLD ID SANDBOX — never point at production
# identities. Use the sandbox app (app_staging_...) + staging environment;
# proofs are verified against the staging developer portal and can be
# exercised with the sandbox World ID app / simulator.worldcoin.org.
WORLD_ID_ENVIRONMENT=staging   # staging = sandbox; do NOT use production
# WORLD_ID_APP_ID=app_staging_... (your sandbox app id)
# WORLD_ID_RP_ID=<your sandbox Relying Party id, usually a .com domain you own>
# WORLD_ID_VERIFY_URL=https://staging-developer.worldcoin.org/api/v4/verify/
# WORLD_SIGN_TTL_SECONDS=300
# WORLD_ID_MOCK=1

# --- World Chain (AgentBook lookups + AgentKit gate) ---
# Optional RPC override for on-chain AgentBook reads (defaults to the
# canonical public endpoint) and the chain id bound into agentkit headers.
# WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# WORLD_CHAIN_ID=eip155:480

# --- Frontend (Vite requires VITE_ prefix) ---
# World ID environment shown in the header/UI — sandbox for this project.
VITE_WORLD_ENVIRONMENT=sandbox
VITE_RPC_URL=https://sepolia.infura.io/v3/<your-key>
VITE_CREDIT_BUREAU_ADDRESS=0x...
VITE_ESCROW_ADDRESS=0x...
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/agent-credit-bureau/version/latest
VITE_ENS_ROOT_NAME=agentcreditbureau.eth
VITE_ENS_AGENT_SUBNAME_REGISTRAR_ADDRESS=0x<deployed-project-registrar>
VITE_ENS_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780
VITE_ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e