# Frontend environment. Copy to .env and fill in AFTER deploying the contracts
# and the ENSv2 namespace (see ../README.md "Submission-ready live deployment
# checklist"). Project addresses are never hard-coded — the app refuses to run
# the on-chain flows until they are set.
VITE_RPC_URL=https://sepolia.infura.io/v3/<your-key>
# World ID environment shown in the header/UI — sandbox for this project.
VITE_WORLD_ENVIRONMENT=sandbox
VITE_CREDIT_BUREAU_ADDRESS=0x<deployed-credit-bureau>
VITE_ESCROW_ADDRESS=0x<deployed-credit-escrow>
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/agent-credit-bureau/version/latest
VITE_BACKEND_URL=http://127.0.0.1:8787
VITE_ENS_ROOT_NAME=agentcreditbureau.eth
VITE_ENS_AGENT_SUBNAME_REGISTRAR_ADDRESS=0x<deployed-agent-subname-registrar>
# ENS protocol constants (official Sepolia hackathon deployment) — override only if ENS redeploys.
VITE_ENS_VERIFIABLE_FACTORY=0x894bc9cc8ff1ad96b8a288c86a8c71d662c07780
VITE_ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
# Optional server-side bridge for the Verify World page. The bridge must run
# integrations/world/verify-agent.js and keep AgentKit/deployer credentials server-side.
# Optional route overrides. By default the frontend uses VITE_BACKEND_URL/api/*.
VITE_WORLD_VERIFY_URL=http://127.0.0.1:8787/api/world/verify
VITE_WORLD_STATUS_URL=http://127.0.0.1:8787/api/world/status
VITE_WORLD_GATE_URL=http://127.0.0.1:8787/api/world/gate
# AgentBook registration (run FIRST when minting an agent identity — the
# backend registers the controller in the World AgentBook, and only a
# successful registration sets the on-chain humanBacked flag).
VITE_WORLD_REGISTER_URL=http://127.0.0.1:8787/api/world/register
# Optional: route override for the MCP chat bridge (defaults to VITE_BACKEND_URL/api/chat).
# VITE_MCP_CHAT_URL=http://127.0.0.1:8787/api/chat
# Optional AI narrative leg for the analyst panels. The deterministic,
# evidence-backed decision works WITHOUT a key — leave blank to skip the LLM.
# VITE_OPENAI_API_KEY=sk-...
# VITE_AI_MODEL_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_MODEL=gpt-4o-mini
# World Selfie Check (prize track) — RP signing + proof verification happen
# server-side; the frontend only forwards the completed proof payload.
VITE_WORLD_SELFIE_SIGN_URL=http://127.0.0.1:8787/api/world/selfie/sign
VITE_WORLD_SELFIE_VERIFY_URL=http://127.0.0.1:8787/api/world/selfie/verify
# Canonical AgentBook registry on World Chain (protocol constant — override only for testnets).
# VITE_WORLD_AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA